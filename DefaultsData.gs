function defaultSupervisionCriteriaRows() {
  var rows = [];
  Object.keys(DEFAULT_SUPERVISION_CRITERIA).forEach(function (formType) {
    DEFAULT_SUPERVISION_CRITERIA[formType].forEach(function (item, index) {
      rows.push({ formType: formType, sortNo: index + 1, item: item, maxScore: 5, isActive: true });
    });
  });
  return rows;
}

function defaultPaCriteriaRows() {
  var components = APP_CONFIG.PA_COMPONENTS;
  var rows = [];
  APP_CONFIG.PA_TEMPLATES.forEach(function (template) {
    var standard = template.key === 'assistant' ? PA_ASSISTANT_ITEMS : PA_STANDARD_ITEMS;
    standard.forEach(function (items, side) {
      items.forEach(function (item, index) {
        rows.push({ template: template.name, component: components[side].name, sortNo: index + 1, item: item, description: '', evidence: '' });
      });
    });
    if (template.challenge > 0) {
      rows.push({ template: template.name, component: components[3].name, sortNo: 1, item: 'ระดับความสำเร็จในการพัฒนางานที่เสนอเป็นประเด็นท้าทาย',
        description: 'พิจารณาจากผลลัพธ์การเรียนรู้ของผู้เรียนที่เกิดจากประเด็นท้าทาย', evidence: 'รายงานผลการพัฒนางานตามประเด็นท้าทาย' });
    }
    PA_COMMON_ITEMS.c2.concat([]).forEach(function (item, index) {
      rows.push({ template: template.name, component: components[4].name, sortNo: index + 1, item: item[0], description: item[1], evidence: '' });
    });
    PA_COMMON_ITEMS.c3.forEach(function (item, index) {
      rows.push({ template: template.name, component: components[5].name, sortNo: index + 1, item: item[0], description: item[1], evidence: '' });
    });
  });
  return rows;
}

// เติมเกณฑ์ตั้งต้นเมื่อตารางยังว่าง (รวมแถวที่ถูกลบ เพื่อไม่เติมซ้ำหลังผู้ดูแลระบบลบเอง)
function seedModuleDefaults(actorId) {
  if (SheetRepository.all('SupervisionCriteria', { includeDeleted: true }).length === 0) {
    SheetRepository.insertMany('SupervisionCriteria', defaultSupervisionCriteriaRows(), actorId || 'system');
  }
  if (SheetRepository.all('PaCriteria', { includeDeleted: true }).length === 0) {
    SheetRepository.insertMany('PaCriteria', defaultPaCriteriaRows(), actorId || 'system');
  }
}
