  // ความรู้สำหรับคำถามนี้: ส่วนกลาง + หมวดของหน้าที่เปิด + หมวดที่บอทตัวนี้ถนัด (ไม่ซ้ำกัน)
  function forBot(bot, pageCategory) {
    var keys = [pageCategory].concat(bot.categories || []).filter(function (key, index, list) {
      return key && SECTIONS[key] && list.indexOf(key) === index;
    });
    var lines = ['[การใช้ระบบโดยทั่วไป]'].concat(COMMON.map(function (line) { return '- ' + line; }));
    keys.forEach(function (key) {
      var group = APP_CONFIG.GROUPS.filter(function (item) { return item.key === key; })[0];
      lines.push('', '[' + (group && group.name ? group.name : 'หน้าหลัก') + ']');
      SECTIONS[key].forEach(function (line) { lines.push('- ' + line); });
    });
    return lines.join('\n');
  }

  return { forBot: forBot, COMMON: COMMON, SECTIONS: SECTIONS };
